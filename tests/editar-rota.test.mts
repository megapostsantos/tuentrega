import { PGlite } from "@electric-sql/pglite";
import fs from "fs";
import { __setQueryImpl, runSetupBatch, executeQuery } from "../src/server/data-engine.ts";
const pg = new PGlite(); __setQueryImpl(async (q, p) => (await pg.query(q, p as any[])).rows as any[]);
const sql = fs.readFileSync(new URL("../src/db/setup.sql", import.meta.url), "utf8");
let off: number | null = 0; while (off !== null) { const r = await runSetupBatch(sql, off, 40); off = r.next; }
const base = { filters: [], order: [] } as any; const run = (c: any, r: any) => executeQuery({ ...base, ...r }, c);
const rpc = (c: any, fn: string, args: any) => run(c, { table: "", op: "rpc", rpc: { fn, args } });
let fail = 0; const ok = (n: string, c: boolean, x?: any) => { if (!c) fail++; console.log(c ? "PASS" : "FAIL", n, c ? "" : JSON.stringify(x)); };
for (const [i, r] of [["E1","empresa"],["E2","empresa"],["D1","entregador"],["D2","entregador"],["D3","entregador"]]) await pg.query(`insert into "user" (id,name,email,role) values ($1,$1,$1||'@x.com',$2)`, [i, r]);
await pg.query(`insert into empresas (id,razao_social) values ('E1','A'),('E2','B')`);
await pg.query(`insert into entregadores (id,nome_completo,status) values ('D1','Guto Silva','ativo'),('D2','Gutto Silva','ativo'),('D3','Outro','ativo')`);
await pg.query(`insert into vinculos_empresa (entregador_id,empresa_id,empresa_nome) values ('D3','E2','B')`);
const opId = ((await pg.query(`insert into operacoes (empresa_id,data_operacao,total_pacotes_sistema,total_pacotes_contados,total_paradas,valor_por_pacote,status,origem) values ('E1','2026-11-16',10,10,0,1.8,'draft','manual') returning id`)).rows[0] as any).id;
const ofId = ((await pg.query(`insert into ofertas (empresa_id,operacao_id,titulo,tipo,status,data_trabalho,entregador_id,quantidade_pacotes) values ('E1',$1,'Origem · Aparecida - 16/11/2026','distribuicao','accepted','2026-11-16','D1',10) returning id`, [opId])).rows[0] as any).id;
const rotaId = ((await pg.query(`insert into rotas_operacao (operacao_id,empresa_id,nome,quantidade_pacotes,oferta_id,status) values ($1,'E1','Aparecida',10,$2,'open') returning id`, [opId, ofId])).rows[0] as any).id;
await pg.query(`insert into alocacoes (operacao_id,rota_id,entregador_id,oferta_id,empresa_id,status) values ($1,$2,'D1',$3,'E1','allocated')`, [opId, rotaId, ofId]);
const dono = { userId: "E1", role: "empresa" }, outra = { userId: "E2", role: "empresa" }, func = { userId: "E1", role: "empresa", operador: true };
const of = async () => (await pg.query(`select status, entregador_id, titulo from ofertas where id=$1`, [ofId])).rows[0] as any;
const al = async () => (await pg.query(`select entregador_id, status from alocacoes where rota_id=$1 and status not in ('removida','recusada')`, [rotaId])).rows as any[];

let r: any = await rpc(outra, "editar_rota", { _rota_id: rotaId, _entregador_id: "D2" });
ok("outra empresa não edita", !!r.error, r);
r = await rpc(dono, "editar_rota", { _rota_id: rotaId, _entregador_id: "D3" });
ok("não pega parceiro exclusivo de outra empresa", !!r.error, r);
r = await rpc(dono, "editar_rota", { _rota_id: rotaId, _entregador_id: "D2", _nome: "Aparecida Norte" });
let o = await of(); let a = await al();
ok("troca o parceiro (D1 → D2) e o nome", !r.error && o.entregador_id === "D2" && o.status === "accepted" && o.titulo === "Origem · Aparecida Norte - 16/11/2026" && a.length === 1 && a[0].entregador_id === "D2", [r, o, a]);
ok("nome da rota atualizado", ((await pg.query(`select nome from rotas_operacao where id=$1`, [rotaId])).rows[0] as any).nome === "Aparecida Norte");
ok("os dois parceiros foram avisados", (await pg.query(`select user_id from user_notifications order by user_id`)).rows.map((x: any) => x.user_id).join() === "D1,D2");
r = await rpc(func, "editar_rota", { _rota_id: rotaId, _entregador_id: null });
o = await of(); a = await al();
ok("funcionário também pode tirar o parceiro: volta ao mercado", !r.error && o.entregador_id === null && o.status === "open" && a.length === 0, [r, o, a]);
r = await rpc(dono, "editar_rota", { _rota_id: rotaId, _entregador_id: "D1" });
ok("reatribuir ao mesmo parceiro de antes funciona", !r.error && (await of()).entregador_id === "D1" && (await al()).length === 1, r);
r = await rpc(dono, "editar_rota", { _rota_id: rotaId, _nome: "Só renomear" });
ok("só renomear não mexe no parceiro", !r.error && (await of()).entregador_id === "D1", r);
await pg.query(`update ofertas set status='in_progress' where id=$1`, [ofId]);
r = await rpc(dono, "editar_rota", { _rota_id: rotaId, _entregador_id: "D2" });
ok("rota em andamento não pode ser editada", !!r.error && (await of()).entregador_id === "D1", r);
console.log(fail ? `${fail} FALHAS` : "✔ editar-rota.test.mts");
process.exit(fail ? 1 : 0);
