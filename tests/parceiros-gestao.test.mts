import { PGlite } from "@electric-sql/pglite";
import fs from "fs";
import { __setQueryImpl, runSetupBatch, executeQuery } from "../src/server/data-engine.ts";
const pg = new PGlite(); __setQueryImpl(async (q, p) => (await pg.query(q, p as any[])).rows as any[]);
const sql = fs.readFileSync(new URL("../src/db/setup.sql", import.meta.url), "utf8");
let off: number | null = 0; while (off !== null) { const r = await runSetupBatch(sql, off, 40); off = r.next; }
const base = { filters: [], order: [] } as any; const run = (c: any, r: any) => executeQuery({ ...base, ...r }, c);
const rpc = (c: any, fn: string, args: any) => run(c, { table: "", op: "rpc", rpc: { fn, args } });
const dono = { userId: "E1", role: "empresa" }, op = { userId: "E1", role: "empresa", operador: true }, outra = { userId: "E2", role: "empresa" };
let fail = 0; const ok = (n: string, c: boolean, x?: any) => { if (!c) fail++; console.log(c ? "PASS" : "FAIL", n, c ? "" : JSON.stringify(x)); };

for (const [i, r] of [["E1","empresa"],["E2","empresa"],["D1","entregador"]]) await pg.query(`insert into "user" (id,name,email,role) values ($1,$1,$1||'@x.com',$2)`, [i, r]);
await pg.query(`insert into empresas (id,razao_social) values ('E1','A'),('E2','B')`);
let r: any = await rpc(dono, "cadastrar_entregador_gerenciado", { nome_completo: "Enzo", whatsapp: "13997237271" });
const enzo = r.data.id;
ok("pré-cadastro sem e-mail criado", !!enzo, r);
r = await rpc(outra, "atualizar_email_convite", { user_id: enzo, email: "enzo@x.com" });
ok("outra empresa não edita e-mail", !!r.error, r);
r = await rpc(op, "atualizar_email_convite", { user_id: enzo, email: "enzo@x.com" });
ok("operador não edita e-mail", !!r.error, r);
r = await rpc(dono, "atualizar_email_convite", { user_id: enzo, email: "invalido" });
ok("e-mail inválido recusado", !!r.error, r);
r = await rpc(dono, "atualizar_email_convite", { user_id: enzo, email: "D1@x.com" });
ok("e-mail já usado recusado", !!r.error, r);
r = await rpc(dono, "atualizar_email_convite", { user_id: enzo, email: "Enzo@Gmail.com" });
ok("e-mail salvo e devolve código", r.data?.email === "enzo@gmail.com" && !!r.data?.codigo, r);
const u = (await pg.query(`select email from "user" where id=$1`, [enzo])).rows[0] as any;
ok("e-mail gravado no usuário", u.email === "enzo@gmail.com", u);
r = await rpc(op, "remover_parceiro", { entregador_id: enzo });
ok("operador não remove", !!r.error, r);
r = await rpc(outra, "remover_parceiro", { entregador_id: enzo });
ok("outra empresa não remove", !!r.error, r);
r = await rpc(dono, "remover_parceiro", { entregador_id: enzo });
ok("pré-cadastro apagado de vez", r.data?.apagado === true && (await pg.query(`select 1 from "user" where id=$1`, [enzo])).rows.length === 0, r);
await pg.query(`insert into vinculos_empresa (entregador_id,empresa_id,empresa_nome) values ('D1','E1','A')`);
r = await rpc(dono, "remover_parceiro", { entregador_id: "D1" });
ok("ativo só perde o vínculo", r.data?.apagado === false && (await pg.query(`select 1 from "user" where id='D1'`)).rows.length === 1 && (await pg.query(`select 1 from vinculos_empresa where entregador_id='D1'`)).rows.length === 0, r);
r = await rpc(dono, "cadastrar_membro_equipe", { nome_completo: "Bia", email: "bia@x.com" });
const bia = r.data.id;
r = await rpc(outra, "remover_membro_equipe", { user_id: bia });
ok("outra empresa não remove funcionário", !!r.error, r);
r = await rpc(dono, "remover_membro_equipe", { user_id: bia });
ok("dono remove funcionário", !r.error && (await pg.query(`select 1 from "user" where id=$1`, [bia])).rows.length === 0, r);
console.log(fail ? `${fail} FALHAS` : "✔ parceiros-gestao.test.mts");
process.exit(fail ? 1 : 0);
