import { PGlite } from "@electric-sql/pglite";
import fs from "fs";
import { __setQueryImpl, runSetupBatch, executeQuery } from "../src/server/data-engine.ts";
const pg = new PGlite(); __setQueryImpl(async (q, p) => (await pg.query(q, p as any[])).rows as any[]);
const sql = fs.readFileSync(new URL("../src/db/setup.sql", import.meta.url), "utf8");
let off: number | null = 0; while (off !== null) { const r = await runSetupBatch(sql, off, 40); off = r.next; }
const base = { filters: [], order: [] } as any; const run = (c: any, r: any) => executeQuery({ ...base, ...r }, c);
const rpc = (c: any, fn: string, args: any) => run(c, { table: "", op: "rpc", rpc: { fn, args } });
let fail = 0; const ok = (n: string, c: boolean, x?: any) => { if (!c) fail++; console.log(c ? "PASS" : "FAIL", n, c ? "" : JSON.stringify(x)); };
const eq = (col: string, val: any) => ({ k: "f", col, op: "eq", val });
for (const [i, r] of [["E1","empresa"],["E2","empresa"]]) await pg.query(`insert into "user" (id,name,email,role) values ($1,$1,$1||'@x.com',$2)`, [i, r]);
await pg.query(`insert into empresas (id,razao_social) values ('E1','A'),('E2','B')`);
const dono = { userId: "E1", role: "empresa" }, outra = { userId: "E2", role: "empresa" }, func = { userId: "E1", role: "empresa", operador: true, equipe: true }, sup = { userId: "E1", role: "empresa", operador: false, equipe: true };
let r: any = await rpc(dono, "cadastrar_membro_equipe", { nome_completo: "Bia", email: "bia@x.com" });
const bia = r.data.id;
r = await run(dono, { table: "equipe_empresa", op: "update", values: { salario_fixo: 2000, valor_por_entrega: 0.5 }, filters: [eq("user_id", bia)] });
ok("dono define salário fixo e valor por entrega", !r.error, r);
r = await run(dono, { table: "equipe_empresa", op: "select", columns: "*", filters: [eq("user_id", bia)] });
ok("dono vê a remuneração", Number(r.data[0].salario_fixo) === 2000 && Number(r.data[0].valor_por_entrega) === 0.5, r.data?.[0]);
r = await run(func, { table: "equipe_empresa", op: "select", columns: "*", filters: [eq("user_id", bia)] });
ok('funcionário não vê salário nem com select("*")', r.data[0].salario_fixo === null && r.data[0].valor_por_entrega === null, r.data?.[0]);
r = await run(func, { table: "equipe_empresa", op: "update", values: { salario_fixo: 9999 }, filters: [eq("user_id", bia)] });
ok("funcionário não altera salário", !!r.error, r);
r = await run(sup, { table: "equipe_empresa", op: "update", values: { salario_fixo: 9999 }, filters: [eq("user_id", bia)] });
ok("supervisor não altera salário", !!r.error, r);
r = await run(dono, { table: "pagamentos_equipe", op: "insert", values: { membro_id: bia, tipo: "salario", referencia: "2026-11", valor: 2000, data_pagamento: "2026-11-05" }, returning: true, single: "single" });
ok("dono registra pagamento ao funcionário (empresa forçada)", !r.error && r.data.empresa_id === "E1", r);
r = await run(func, { table: "pagamentos_equipe", op: "insert", values: { empresa_id: "E1", membro_id: bia, tipo: "salario", valor: 1 } });
ok("funcionário não registra pagamento", !!r.error, r);
r = await run(func, { table: "pagamentos_equipe", op: "select", columns: "*", filters: [] });
ok("funcionário não lê pagamentos da equipe", r.data.length === 0, r);
r = await run(outra, { table: "pagamentos_equipe", op: "select", columns: "*", filters: [] });
ok("outra empresa não lê", r.data.length === 0, r);
r = await run(sup, { table: "pagamentos_equipe", op: "select", columns: "*", filters: [] });
ok("supervisor lê (trabalha com o financeiro)", r.data.length === 1, r);
console.log(fail ? `${fail} FALHAS` : "✔ equipe-pagamento.test.mts");
process.exit(fail ? 1 : 0);
